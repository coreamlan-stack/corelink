{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoreLink",
  "version": "0.1.0",
  "identifier": "dev.coreamlan.corelink",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "CoreLink", "width": 1120, "height": 840, "minWidth": 680, "minHeight": 600, "backgroundColor": "#09090b" }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"], "windows": { "nsis": { "displayLanguageSelector": false } } }
}
